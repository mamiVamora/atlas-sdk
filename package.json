{
  "name": "@qanati-atlas/sdk",
  "version": "1.0.0",
  "description": "Atlas Marketplace SDK: plugin manifest, permission, theme-section and version compatibility validators",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "assets/atlas-logo-horizontal.png"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "author": "Qanati Atlas Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mamiVamora/atlas-sdk.git"
  },
  "homepage": "https://github.com/mamiVamora/atlas-sdk#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "qanati",
    "atlas",
    "sdk",
    "marketplace",
    "plugins",
    "themes",
    "manifest",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/mamiVamora/atlas-sdk/issues"
  }
}
